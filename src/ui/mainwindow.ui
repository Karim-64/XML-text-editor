/* =====================================================
   BROWSE BUTTON - GLASS STYLE + UNIFIED BORDER
   ===================================================== */
QPushButton#browseButton {
    background: rgba(255,255,255,0.05);
height: 64px;
    min-width: 180px;
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    border-radius: 32px; /* fully rounded corners */
    border: 2px solid rgba(139,92,246,0.5); /* unified border */
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 12px 50px rgba(139,92,246,0.6), 0 0 70px rgba(99,102,241,0.4);
}

QPushButton#browseButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #c084fc,
        stop:0.2 #a78bfa,
        stop:0.5 #818cf8,
        stop:0.8 #60a5fa,
        stop:1 #3b82f6
    );
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 25px 90px rgba(139,92,246,1), 0 0 120px rgba(99,102,241,0.8);
    border: 2px solid rgba(168,85,247,0.8);
}

QPushButton#browseButton:pressed {
    transform: translateY(-1px) scale(0.98);
    box-shadow: 0 12px 50px rgba(139,92,246,0.7), 0 0 70px rgba(99,102,241,0.5);
}

