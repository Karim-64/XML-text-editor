}

/* Mutual Button */
QPushButton#mutualButton {
    height: 40px;
    min-width: 110px;
    padding: 0 15px;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    border-radius: 20px;
    border: none;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139,92,246,0.9),
        stop:1 rgba(99,102,241,0.9)
    );
}

/* Search Button */
QPushButton#searchButton {
    height: 40px;
    min-width: 80px;
    padding: 0 15px;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    border-radius: 20px;
    border: none;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139,92,246,0.9),
        stop:1 rgba(99,102,241,0.9)
    );
}

/* Common Button Hover */
QPushButton#mutualButton:hover,
QPushButton#searchButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(168,85,247,0.9),
        stop:1 rgba(124,58,237,0.9)
    );
    transform: translateY(-2px);
}

/* Common Button Pressed */
QPushButton#mutualButton:pressed,
QPushButton#searchButton:pressed {
    transform: translateY(0);
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(124,58,237,0.9),
        stop:1 rgba(109,40,217,0.9)
    );
}

/* Hover &amp; Focus States */
QLineEdit#lineEdit:hover, QLineEdit#lineEdit:focus,
QLineEdit#lineEdit_2:hover, QLineEdit#lineEdit_2:focus {
    border: 2px solid rgba(139,92,246,0.6);
    background: rgba(255,255,255,0.1);
}
QComboBox#searchModeCombo:hover, QComboBox#searchModeCombo:focus {
    border: 2px solid rgba(139,92,246,0.6);
    background: rgba(255,255,255,0.1);
}
/* Placeholder Text */
QLineEdit#lineEdit::placeholder,
QLineEdit#lineEdit_2::placeholder {
    color: rgba(160,174,192,0.6);
    font-style: italic;
    font-size: 13px;
}

/* Horizontal Line Separator */
QFrame#line {
    background: rgba(139,92,246,0.3);
    border: none;
    height: 1px;
    margin: 10px 0;
}

/* =====================================================
   ENHANCED COMBOBOX
   ===================================================== */

QComboBox#searchModeCombo {
    background: rgba(255,255,255,0.08);
    height: 45px;
    min-width: 160px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    color: #E0E7FF;
    border-radius: 22px;
    border: 1.5px solid rgba(139,92,246,0.5);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);

}

QComboBox#searchModeCombo:hover {

    border: 1.5px solid rgba(139,92,246,0.6);
    background: rgba(255,255,255,0.09);
    box-shadow: inset 0 2px 12px rgba(0,0,0,0.3),
                0 0 0 2px rgba(139,92,246,0.1);

}

/* =====================================================
   ENHANCED STATUS LABEL
   ===================================================== */

QLabel#statusLabel {
    color: #A0AEC0;
    font-style: italic;
    font-size: 14px;
    font-weight: 600;
    padding: 15px;
    background: rgba(30,30,70,0.6);
    border-radius: 15px;
    border-left: 4px solid #8B5CF6;
    border-top: 1px solid rgba(139,92,246,0.3);
    border-bottom: 1px solid rgba(139,92,246,0.3);
    margin-top: 20px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
    box-shadow: 
        inset 0 1px 0 rgba(255,255,255,0.1),
        0 4px 15px rgba(0,0,0,0.2);
}

/* =====================================================
   LAYOUT SPACING IMPROVEMENTS
   ===================================================== */

QVBoxLayout#groupBoxVerticalLayout {
    spacing: 18px;
    margin: 20px 15px;
}

QHBoxLayout#mutualHorizontalLayout,
QHBoxLayout#searchHorizontalLayout {
    spacing: 15px;
    margin: 10px 0;
}

/* Form rows spacing */
QWidget {
    spacing: 12px;
}

/* =====================================================
   PLACEHOLDER ENHANCEMENTS
   ===================================================== */

QLineEdit#lineEdit::placeholder,
QLineEdit#lineEdit_2::placeholder,
QSpinBox::placeholder {
    color: rgba(203,213,224,0.6);
    font-style: italic;
    font-size: 14px;
    font-weight: 500;
}

/* =====================================================
   SECTION SEPARATORS (Visual organization)
   ===================================================== */

/* Optional: Add visual separators between sections */
QFrame[frameShape=&quot;4&quot;] { /* HLine */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.5 rgba(139,92,246,0.3),
        stop:1 transparent
    );
    max-height: 1px;
    margin: 20px 0;
}

QSpinBox {
     background: rgba(255,255,255,0.08);
    height: 45px;
    min-width: 160px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    color: #E0E7FF;
    border-radius: 22px;
    border: 1.5px solid rgba(139,92,246,0.5);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}
/* =====================================================
   SPINBOX – SMALLER ARROWS (SIDE, MINIMAL)
   ===================================================== */
/* =====================================================
   SPINBOX – CLEAR, VISIBLE ARROWS (COMPACT)
   ===================================================== */

/* =====================================================
   SPINBOX – ARROWS (SLIGHTLY BIGGER + HOVER)
   ===================================================== */


/* Hover background */
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background: rgba(139,92,246,0.45);
}

/* Pressed */
QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background: rgba(124,58,237,0.75);
}

/* =====================
   ARROW SHAPES
   ===================== */

QSpinBox::up-arrow,
QSpinBox::down-arrow {
    margin: auto;
    transition: all 0.2s ease;
}



/* Arrow hover glow */
QSpinBox::up-button:hover QSpinBox::up-arrow,
QSpinBox::down-button:hover QSpinBox::down-arrow {
    border-bottom-color: #FFFFFF;
    border-top-color: #FFFFFF;
}

/* =====================================================
   COMBOBOX DROPDOWN LIST ENHANCEMENT
   ===================================================== */
QComboBox#searchModeCombo QAbstractItemView {
    background: rgba(25, 25, 50, 0.95);
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 12px;
    padding: 8px;
    outline: none;
    selection-background-color: rgba(139, 92, 246, 0.5);
    selection-color: white;
    color: #E0E7FF;
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

/* List item hover effect */
QComboBox#searchModeCombo QAbstractItemView::item {
    height: 36px;
    padding: 0 15px;
    border-radius: 8px;
    margin: 2px 0;
}

QComboBox#searchModeCombo QAbstractItemView::item:hover {
    background: rgba(139, 92, 246, 0.3);
    color: white;
    font-weight: 600;
}

QComboBox#searchModeCombo QAbstractItemView::item:selected {
    background: rgba(139, 92, 246, 0.6);
    color: white;
    font-weight: 600;
    border-left: 3px solid #FFFFFF;
}


