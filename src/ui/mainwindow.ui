/* =====================================================
   CENTRAL WIDGETS (GLASS + DEEP NEON)
   ===================================================== */
/* =====================================================
   CARD CONTAINER (MONOCHROME NEON PREMIUM)
   ===================================================== */
QFrame#cardFrame {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(18,18,55,0.9),
        stop:1 rgba(38,38,95,0.9)
    );
    border-radius: 28px;
    border: 1px solid rgba(79,139,255,0.6);
    box-shadow: 0 6px 35px rgba(0,0,64,0.8), 0 0 18px rgba(79,139,255,0.45);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}
QFrame#cardFrame:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 65px rgba(0,0,64,0.95), 0 0 55px rgba(79,139,255,0.65);
}

/* =====================================================
   TITLES (PREMIUM MONOCHROME NEON)
   ===================================================== */
QLabel#titleLabel {
    font-size: 34px;
    font-weight: 900;
    color: #E0E7FF;
    text-shadow: 0 0 12px #4F8BFF, 0 0 25px #6FA3FF, 0 0 40px #2563EB;
}
QLabel#subtitleLabel {
    font-size: 17px;
    color: #A0AEC0;
    text-shadow: 0 0 4px rgba(0,0,64,0.6);
    letter-spacing: 0.6px;
}

/* =====================================================
   INPUT FIELDS (GLASS + NEON PREMIUM)
   ===================================================== */
QTextEdit, QLineEdit {
    height: 50px;
    padding: 0 18px;
    font-size: 15px;
    color: #E0E7FF;
    background: rgba(255,255,255,0.06);
    border-radius: 18px;
    border: 1px solid rgba(79,139,255,0.45);
    backdrop-filter: blur(14px);
    box-shadow: inset 0 0 8px rgba(79,139,255,0.2);
    transition: all 0.35s ease, box-shadow 0.35s ease;
}
QTextEdit, QLineEdit:hover {
    border: 1px solid #4F8BFF;
    box-shadow: 0 0 16px #4F8BFF, inset 0 0 8px rgba(79,139,255,0.25);
}
QTextEdit, QLineEdit:focus {
    border: 2px solid #2563EB;
    box-shadow: 0 0 25px #2563EB, inset 0 0 12px rgba(79,139,255,0.3);
}
/* =====================================================
   BUTTON COMMON STYLE (ALL THREE)
