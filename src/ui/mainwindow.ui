/* =====================================================
   MENU BAR - PREMIUM STYLE WITH ROUNDED CORNERS
   ===================================================== */
QMenuBar {
    background: rgba(18,18,55,0.8);
    color: #E0E7FF;
    border-bottom: 1px solid rgba(79,139,255,0.3);
    padding: 5px;
    font-size: 14px;
    border-radius: 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 16px;
    border-radius: 12px;
    margin: 2px;
}

QMenuBar::item:selected {
    background: rgba(79,139,255,0.2);
    border: 1px solid rgba(79,139,255,0.4);
    border-radius: 12px;
}

QMenuBar::item:pressed {
    background: rgba(79,139,255,0.3);
    border-radius: 12px;
}

/* =====================================================
   MENU DROPDOWN - PREMIUM STYLE WITH ROUNDED CORNERS
   ===================================================== */
QMenu {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(18,18,55,0.95),
        stop:1 rgba(28,28,75,0.95)
    );
    color: #E0E7FF;
    border: 1px solid rgba(79,139,255,0.5);
    border-radius: 16px;
    padding: 8px;
}

QMenu::item {
    padding: 10px 30px 10px 20px;
    border-radius: 10px;
    margin: 2px;
}

QMenu::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139,92,246,0.3),
        stop:1 rgba(99,102,241,0.3)
    );
    border: 1px solid rgba(139,92,246,0.5);
    border-radius: 10px;
}

QMenu::separator {
    height: 1px;
    background: rgba(79,139,255,0.3);
    margin: 5px 10px;
    border-radius: 1px;
}
