       <property name="styleSheet">
        <string notr="true">/* =====================================================
   ENHANCED LAYOUT STYLES
   ===================================================== */
/* =====================================================
   PAGE 2 - COMPLETE STYLESHEET
   ===================================================== */

/* Page Container */
QWidget#page_4 {
    background: transparent;
    border: none;
}

/* Main Card Container */
QFrame#cardFrame_3 {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(18,18,55,0.95),
        stop:1 rgba(28,28,65,0.95)
    );
    border-radius: 32px;
    border: 2px solid rgba(139,92,246,0.4);
    box-shadow: 0 20px 60px rgba(0,0,0,0.6), 
                0 0 40px rgba(79,139,255,0.3),
                inset 0 1px 0 rgba(255,255,255,0.1);
}

/* Main Title */
QLabel#functionLabel {
    font-size: 42px;
    font-weight: 900;
    background-clip: text;
    color: white;

    text-shadow: 0 0 30px rgba(139,92,246,0.5);
  qproperty-alignment: 'AlignCenter';
    qproperty-alignment: AlignCenter;
}

/* =====================================================
   SECTION LABELS
   ===================================================== */
QLabel#sectionLabel1,
QLabel#sectionLabel2,
QLabel#sectionLabel3,
QLabel#sectionLabel4 {
    font-size: 18px;
    font-weight: 600;
    color: #A0AEC0;
    padding: 0px 0 5px 0;
    border-bottom: 1px solid rgba(79,139,255,0.2);
    margin: 0px 0 10px 0;
}

/* =====================================================
   PROCESSING FUNCTION BUTTONS
   ===================================================== */
QPushButton#XMLconsistency_2,
QPushButton#Minifying_2,
QPushButton#Prettifying_2,
QPushButton#XMLtoJSON_2,
QPushButton#Compression_2,
QPushButton#Decompresssion_2 {
    background: rgba(255,255,255,0.08);
    height: 45px;
    min-width: 160px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    color: #E0E7FF;
    border-radius: 22px;
    border: 1.5px solid rgba(139,92,246,0.5);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

QPushButton#XMLconsistency_2:hover,
QPushButton#Minifying_2:hover,
QPushButton#Prettifying_2:hover,
QPushButton#XMLtoJSON_2:hover,
QPushButton#Compression_2:hover,
QPushButton#Decompresssion_2:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #8B5CF6,
        stop:1 #3B82F6
    );
    border: 1.5px solid rgba(255,255,255,0.3);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(139,92,246,0.4);
}

QPushButton#XMLconsistency_2:pressed,
QPushButton#Minifying_2:pressed,
QPushButton#Prettifying_2:pressed,
QPushButton#XMLtoJSON_2:pressed,
QPushButton#Compression_2:pressed,
QPushButton#Decompresssion_2:pressed {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(139,92,246,0.3);
}

/* =====================================================
   NETWORK ANALYSIS BUTTONS
   ===================================================== */
QPushButton#mostActiveButton,
QPushButton#mostInfluencerButton,
QPushButton#user1suggestButton {
     background: rgba(255,255,255,0.08);
    height: 45px;
    min-width: 160px;
    padding: 0 20px;
    font-size: 14px;
    font-weight: 600;
    color: #E0E7FF;
    border-radius: 22px;
    border: 1.5px solid rgba(139,92,246,0.5);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

QPushButton#mostActiveButton:hover,
QPushButton#mostInfluencerButton:hover,
QPushButton#user1suggestButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #8B5CF6,
        stop:1 #3B82F6
    );
    border: 1.5px solid rgba(255,255,255,0.3);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(139,92,246,0.4);
}

QPushButton#mostActiveButton:pressed,
QPushButton#mostInfluencerButton:pressed,
QPushButton#user1suggestButton:pressed {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(139,92,246,0.3);
}

/* =====================================================
   UTILITY BUTTONS
   ===================================================== */
QPushButton#graph_2,
QPushButton#backButton,
QPushButton#save_2 {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #8B5CF6,
        stop:1 #3B82F6
    );
    height: 45px;
    min-width: 160px;
    padding: 0 25px;
    font-size: 15px;
    font-weight: 700;
    color: white;
    border-radius: 22px;
    border: none;
    box-shadow: 0 8px 30px rgba(139,92,246,0.4);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
}

QPushButton#graph_2:hover,
QPushButton#backButton:hover,
QPushButton#save_2:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #7C3AED,
        stop:1 #2563EB
    );
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(139,92,246,0.6);
}

QPushButton#graph_2:pressed,
QPushButton#backButton:pressed,
QPushButton#save_2:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #6D28D9,
        stop:1 #1D4ED8
    );
    transform: translateY(0);
    box-shadow: 0 4px 15px rgba(139,92,246,0.4);
}

/* =====================================================
   RESULTS TEXT AREA
   ===================================================== */
QTextEdit#textEdit_2 {
    padding: 20px;
    font-size: 15px;
    font-family: &quot;Consolas&quot;, &quot;Monaco&quot;, monospace;
    color: #E0E7FF;
    background: rgba(0,0,0,0.3);
    border-radius: 20px;
    border: 1px solid rgba(139,92,246,0.3);
    selection-background-color: rgba(139,92,246,0.5);
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
}

QTextEdit#textEdit_2:focus {
    border: 2px solid rgba(139,92,246,0.6);
    box-shadow: inset 0 2px 15px rgba(0,0,0,0.4),
                0 0 20px rgba(139,92,246,0.2);
}

/* =====================================================
   SEARCH &amp; ANALYSIS SECTION
   ===================================================== */
QGroupBox#searchGroupBox {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.05),
        stop:1 rgba(255,255,255,0.03)
    );
    border: 1.5px solid rgba(139,92,246,0.4);
    border-radius: 22px;
    margin-top: 15px;
    padding-top: 20px;
    color: #CBD5E0;
    font-size: 16px;
    font-weight: 700;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.2),
                inset 0 1px 0 rgba(255,255,255,0.1);
}

QGroupBox#searchGroupBox::title {
    
    font-style: italic;
    font-size: 17px;
    padding: 10px; color: #E0E7FF;
    border-radius: 10px;
    margin-top: 0px;
    subcontrol-origin: margin;
    left: 0px;
  
    
}

/* Search Section Labels */
QLabel#mutualLabel,
QLabel#searchLabel {
    font-size: 14px;
    font-weight: 600;
    color: #A0AEC0;
    padding: 5px 0;
    min-width: 120px;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
}

/* Search Input Fields */
QLineEdit#lineEdit,
QLineEdit#lineEdit_2 {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
    color: #E0E7FF;
    background: rgba(255,255,255,0.07);
    border-radius: 20px;
    border: 1.5px solid rgba(139,92,246,0.3);
    selection-background-color: rgba(139,92,246,0.5);
    selection-color: #FFFFFF;
    transition: all 0.3s ease;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.2);
}

QLineEdit#lineEdit:hover,
QLineEdit#lineEdit_2:hover {
    border: 1.5px solid rgba(139,92,246,0.6);
    background: rgba(255,255,255,0.09);
    box-shadow: inset 0 2px 12px rgba(0,0,0,0.3),
                0 0 0 2px rgba(139,92,246,0.1);
}

QLineEdit#lineEdit:focus,
QLineEdit#lineEdit_2:focus {
    border: 2px solid rgba(139,92,246,0.8);
    background: rgba(255,255,255,0.1);
    box-shadow: inset 0 2px 15px rgba(0,0,0,0.4),
                0 0 0 3px rgba(139,92,246,0.15);
}

/* Search Buttons */
QPushButton#mutualButton,
QPushButton#searchButton {
    height: 40px;
    min-width: 100px;
    padding: 0 25px;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    border-radius: 20px;
    border: none;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(139,92,246,0.9),
        stop:1 rgba(99,102,241,0.9)
    );
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 6px 20px rgba(139,92,246,0.4);
}

QPushButton#mutualButton:hover,
QPushButton#searchButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(168,85,247,0.9),
        stop:1 rgba(124,58,237,0.9)
    );
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(139,92,246,0.6),
                0 0 20px rgba(139,92,246,0.3);
}

QPushButton#mutualButton:pressed,
QPushButton#searchButton:pressed {
    transform: translateY(0);
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(124,58,237,0.9),
        stop:1 rgba(109,40,217,0.9)
    );
    box-shadow: 0 4px 15px rgba(139,92,246,0.4);
}

QGridLayout {
    margin: 5px;
    spacing: 15px;
}

QHBoxLayout, QVBoxLayout {
    spacing: 6px;
}

QVBoxLayout#groupBoxVerticalLayout {
    spacing: 15px;
    margin: 15px;
}

QHBoxLayout#mutualHorizontalLayout,
QHBoxLayout#searchHorizontalLayout {
    spacing: 12px;
    margin: 8px 0;
}

/* =====================================================
   PLACEHOLDER TEXT
   ===================================================== */
QLineEdit#lineEdit::placeholder,
QLineEdit#lineEdit_2::placeholder {
    color: rgba(160,174,192,0.6);
    font-style: italic;
    font-size: 13px;
}

QTextEdit#textEdit_2::placeholder {
    color: rgba(160,174,192,0.5);
    font-style: italic;
    font-size: 14px;
}

/* =====================================================
   SCROLL BARS (Optional Enhancement)
   ===================================================== */
QScrollBar:vertical {
    background: rgba(255,255,255,0.05);
    width: 12px;
    border-radius: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(139,92,246,0.5);
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(139,92,246,0.7);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: rgba(255,255,255,0.05);
    height: 12px;
    border-radius: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: rgba(139,92,246,0.5);
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(139,92,246,0.7);
}
